  "info": {
    "title": "My API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "12345678",
            "description": "User password",
            "minLength": 8,
            "maxLength": 50
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": "True"
          }
        },
        "required": [
          "success"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "letutan500@gmail.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "12345678",
